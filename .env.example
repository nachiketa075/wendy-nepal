# Copy to .env and fill in. Never commit .env.
# There are no default passwords: Docker Compose refuses to start without POSTGRES_PASSWORD,
# and the owner account is created separately (see README, "Create the owner account").

# --- Database ---
POSTGRES_USER=wendy
POSTGRES_DB=wendy
# Generate one with: openssl rand -hex 24
# (letters and digits only, because it is placed inside a database URL)
POSTGRES_PASSWORD=

# --- API ---
# development | production
ENVIRONMENT=development
# Comma-separated browser origins allowed to call the API.
# In production this must be the real https:// site origin(s); "*" is rejected.
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_HOURS=12
# Set to true only behind a reverse proxy you control that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# COOKIE_SECURE defaults to true in production and false in development.

# --- Links and email ---
# Public address of the site. Used in password-reset and staff setup links. https:// in production.
PUBLIC_SITE_URL=http://localhost:5173
# How password-reset emails are sent:
#   disabled  nothing is sent; the site says reset by email is unavailable (default)
#   dev_file  development only: each email is written to backend/dev-mailbox/, nothing is sent
#   smtp      real delivery using the SMTP_* values below
EMAIL_DELIVERY=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Local ports (optional) ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Only when running the API outside Docker ---
# DATABASE_URL=postgresql+psycopg://wendy:<password>@localhost:5432/wendy
