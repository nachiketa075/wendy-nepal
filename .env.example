# Copy to .env and fill in. Never commit .env.
# There are no default passwords: Docker Compose refuses to start without POSTGRES_PASSWORD,
# and the owner account is created separately (see README, "Create the owner account").

# --- Database ---
POSTGRES_USER=wendy
POSTGRES_DB=wendy
# Generate one with: openssl rand -hex 24
# (letters and digits only, because it is placed inside a database URL)
POSTGRES_PASSWORD=

# --- API ---
# development | production
ENVIRONMENT=development
# Comma-separated browser origins allowed to call the API.
# In production this must be the real https:// site origin(s); "*" is rejected.
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_HOURS=12
# Set to true only behind a reverse proxy you control that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# COOKIE_SECURE defaults to true in production and false in development.

# --- Frontend ---
# Where the public menu comes from: pdf (the printed menu, default) or api (the database menu).
VITE_MENU_SOURCE=pdf
# true shows design previews of the customer, staff and team screens with fictional data.
# Works only in the Vite dev server; production builds ignore it.
VITE_ENABLE_PREVIEW=false

# --- Local ports (optional) ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Only when running the API outside Docker ---
# DATABASE_URL=postgresql+psycopg://wendy:<password>@localhost:5432/wendy
