# Production settings. Copy to .env.production on the server and fill in.
# Never commit .env.production. Every value below is a placeholder.

# Public host name of the site, without https://  (Caddy gets the certificate for it)
SITE_ADDRESS=your-domain.example
# The same site as a full address. Used for the allowed origin and for links in
# password-reset emails and staff setup links. Must start with https://
PUBLIC_SITE_URL=https://your-domain.example

# Database (private to the server; not published)
POSTGRES_USER=wendy
POSTGRES_DB=wendy
# Generate with: openssl rand -hex 32   (letters and digits only)
POSTGRES_PASSWORD=

SESSION_TTL_HOURS=12

# Password-reset email.
#   disabled  nothing is sent and the site says reset by email is unavailable
#   smtp      real delivery through the provider below
# (dev_file is refused in production.)
EMAIL_DELIVERY=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
