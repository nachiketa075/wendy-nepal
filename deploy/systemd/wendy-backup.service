# Runs one encrypted database backup. Install to /etc/systemd/system/ and adjust
# WorkingDirectory and User to where the project lives on the server.
[Unit]
Description=Wendy Juice Shop encrypted database backup
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=wendy
WorkingDirectory=/srv/wendy-nepal
ExecStart=/srv/wendy-nepal/scripts/backup.sh
# A failed run exits non-zero and shows as failed in `systemctl status` / `journalctl -u wendy-backup`.
Nice=10
