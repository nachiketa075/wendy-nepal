# Backup settings. Copy to .env.backup on the server (it is git-ignored).
# No secret belongs in this file: the encryption key below is a PUBLIC key.

# Path to the backup PUBLIC key (ASCII-armoured export). Required.
# The matching PRIVATE key must NOT be on this server. See docs/OPERATIONS.md.
BACKUP_GPG_RECIPIENT_FILE=/etc/wendy/backup-public-key.asc

# Where backups are written on this server.
BACKUP_DIR=backups

# Delete local copies older than this many days (leave empty to keep everything).
# Set only after the owner approves a retention period.
BACKUP_KEEP_DAYS=

# Off-server copy: an rclone remote and path, e.g. "wendy-backups:wendy/db".
# The remote's credentials live in rclone's own config file, never here.
# Leave empty and the script warns that the backup exists only on this server.
BACKUP_RCLONE_REMOTE=
